# Copy to .env (git-ignored) and fill in only what you need. Never commit real values.
# Read from the repo root and from the current directory (current directory wins);
# real environment variables override both.

# --- Provider credentials -----------------------------------------------------
GEMINI_API_KEY=            # image (Nano Banana), Veo 3.1, Gemini vision audits
ELEVENLABS_API_KEY=        # TTS + sound effects
REPLICATE_API_TOKEN=       # Kling image-to-video

# --- Cost guard ---------------------------------------------------------------
AIVIDEO_BUDGET_USD=10            # hard ceiling for *estimated* paid-API spend
AIVIDEO_SPEND_LEDGER=.ai-video/spend.jsonl
AIVIDEO_DRY_RUN=false            # validate + estimate without calling any API
# Per-unit price overrides (USD), e.g. if your plan includes Veo:
# AIVIDEO_PRICE_VEO_PER_S=0
# AIVIDEO_PRICE_KLING_PER_S=0.07
# AIVIDEO_PRICE_ELEVENLABS_TTS_PER_1K_CHARS=0.30

# --- Network robustness ------------------------------------------------------
AIVIDEO_HTTP_TIMEOUT_S=120
AIVIDEO_MAX_RETRIES=3
AIVIDEO_POLL_TIMEOUT_S=900

# --- Logging -----------------------------------------------------------------
AIVIDEO_LOG_LEVEL=INFO
AIVIDEO_LOG_JSON=false
