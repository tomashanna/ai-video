# ─── Python ───────────────────────────────────────────────────────────────
.venv/
.venv-*/
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ─── Secrets — NEVER commit (if one was ever pushed: ROTATE the key) ──────
.env
.env.*
!.env.example
*.pem
*.key

# ─── Local tool state ─────────────────────────────────────────────────────
# spend ledger, caches
.ai-video/
.claude/settings.local.json
.claude/worktrees/
.DS_Store
# HyperFrames studio thumbnails (regenerable)
**/.thumbnails/
*.log

# ─── Per-video work (local only; the repo ships the system, not productions) ─
# working specs (examples live in examples/specs/)
/creative-specs/
/projects/
renders/
**/renders/
**/assets/clips*/
**/assets/sfx/
evals/out/
assets/transitions/_previews/

# Reference / research media (third-party; never commit)
videosref_*/
*-refs/
data/referent-analysis/**/ref-*/
data/referent-analysis/**/frames/

# ─── Media: ignored by default, whitelisted only inside the curated asset library ─
*.mp4
*.mov
*.mkv
*.webm
*.wav
*.aif
*.aiff
*.flac
*.m4a
*.mp3
*.zip
*.tar.gz

!assets/library/**/*.mp3
!assets/transitions/**/*.mp3
!assets/avu/*.mp4
